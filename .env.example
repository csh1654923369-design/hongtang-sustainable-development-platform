# 在 Supabase 项目的 Connect 对话框中获取；不要把真实密钥提交到 Git。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# 首页3D实景恢复使用 Cesium ion：模型资产4908525、Cesium World Terrain与Bing航空影像。
# 只把真实令牌写入 .env.local，不要提交到 Git。
CESIUM_ION_TOKEN=your_cesium_ion_access_token

# 首页2D地图使用高德地图 JavaScript API 2.0。只在本机或部署平台中配置真实值。
AMAP_WEB_KEY=your_amap_web_js_api_key
# 2021年12月2日以后申请的新Key通常还需要安全密钥；程序会通过服务端代理使用，不传给浏览器。
AMAP_SECURITY_JS_CODE=your_amap_security_jscode

# SparkJS 流式高斯模型目录。当前正式首页不使用；保留供本地实验或备用查看器使用。
GAUSSIAN_MODEL_DIR=

# CesiumJS 本地高斯三维瓦片目录。当前正式首页不使用；保留为无网络时的备用资源。
LOCAL_CESIUM_MODEL_DIR=
